{
	"name": "mspiechowicz-svelte-blog",
	"version": "1.0.3",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"test:social": "vitest run scripts/social-post.test.js",
		"sync:projects": "node scripts/sync-projects.js",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-vercel": "^7.0.2",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"mdsvex": "^0.12.8",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tslib": "^2.9.1",
		"typescript": "~6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.6"
	},
	"type": "module",
	"dependencies": {
		"oauth-1.0a": "^2.2.6",
		"twitter-text": "^3.1.0",
		"yaml": "^2.9.1"
	},
	"packageManager": "bun@1.4.2",
	"engines": {
		"node": "^26.0.0",
		"bun": ">=1.4.2"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
